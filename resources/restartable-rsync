#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'
# https://superuser.com/a/302843

if [[ $# -lt 2 ]]; then
  echo "Usage: $0 <source> <destination>" >&2
  exit 1
fi

until rsync -avz --partial "$1" "$2"; do
  echo "Rsync failure. Backing off and retrying..."
  sleep 180
done
echo "rsync completed normally"
